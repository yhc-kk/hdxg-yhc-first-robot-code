#include <stdio.h>

int main()
{
    int number = 0;
    int input;
    scanf("%d" , &input);
    for(int i = 1; i <= input; i++)
    {
        if(input % i == 0)
        {
            number++;
        }
    }
    if(number == 2)
    {
        printf("This is a prime number.");
    }
    else
    {
        printf("This is not a prime number.");
    }
    return 0;
}
